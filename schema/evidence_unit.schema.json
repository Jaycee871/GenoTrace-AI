{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenoTrace Evidence Unit",
  "type": "object",
  "required": [
    "claim_id",
    "claim",
    "evidence_type",
    "source",
    "population",
    "causal_status",
    "allowed_interpretation",
    "forbidden_interpretation",
    "limitations"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string"
    },
    "value": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "confidence_interval": {
      "type": [
        "string",
        "null"
      ]
    },
    "p_value": {
      "type": [
        "string",
        "null"
      ]
    },
    "method": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "population": {
      "type": "string"
    },
    "phenotype_definition": {
      "type": [
        "string",
        "null"
      ]
    },
    "causal_status": {
      "type": "string",
      "enum": [
        "ASSOCIATIONAL",
        "CAUSAL",
        "DESCRIPTIVE",
        "PREDICTIVE",
        "UNKNOWN"
      ]
    },
    "allowed_interpretation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_interpretation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance_records": {
      "type": "array",
      "description": "Optional PROV-aligned provenance records linking entities, activities, and agents.",
      "items": {
        "type": "object",
        "required": [
          "entity",
          "activity",
          "agent"
        ],
        "properties": {
          "entity": {
            "type": "string",
            "description": "Artifact or information object, e.g. source paper, dataset, evidence unit, generated claim."
          },
          "activity": {
            "type": "string",
            "description": "Transformation or analysis, e.g. GWAS, LDSC, PheWAS, AI interpretation, governance validation."
          },
          "agent": {
            "type": "string",
            "description": "Human or computational actor responsible for the activity."
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "timestamp": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "evidence_strength": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional qualitative evidence-strength label; must not be inferred when the source does not provide one."
    }
  },
  "additionalProperties": true
}
